{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group non-major Rust dependency bumps into one PR",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "rust dependencies (non-major)"
    },
    {
      "description": "Group non-major UI dependency bumps into one PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "ui dependencies (non-major)"
    },
    {
      "description": "ClickHouse stays on the pinned LTS line unless bumped deliberately",
      "matchPackageNames": ["clickhouse/clickhouse-server"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
